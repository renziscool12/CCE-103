import java.util.Scanner;

public class Pandits {

    static Scanner sc = new Scanner(System.in);

    public static void main(String[] args) {

        int choice;

        do {
            System.out.println("\n1. Convert");
            System.out.println("2. Exit");
            System.out.print("Choice: ");
            choice = Integer.parseInt(sc.nextLine());

            if (choice == 1)
                convert();

        } while (choice != 2);

        System.out.println("Bye");
    }

    static void convert() {

        System.out.print("Enter value: ");
        String num = sc.nextLine().toUpperCase();

        int from = getBase("From (2,8,10,16): ");
        int to = getBase("To (2,8,10,16): ");

        int dec = toDecimal(num, from);
        String res = (to == 10) ? String.valueOf(dec) : fromDecimal(dec, to);

        System.out.println("Result: " + res);
    }

    static int getBase(String msg) {
        while (true) {
            System.out.print(msg);
            int b = Integer.parseInt(sc.nextLine());
            if (b == 2 || b == 8 || b == 10 || b == 16)
                return b;
            System.out.println("Invalid base");
        }
    }

    static int toDecimal(String n, int base) {
        int dec = 0;
        for (int i = 0; i < n.length(); i++)
            dec = dec * base + val(n.charAt(i));
        return dec;
    }

    static String fromDecimal(int dec, int base) {
        String s = "";
        String d = "0123456789ABCDEF";

        while (dec > 0) {
            s = d.charAt(dec % base) + s;
            dec /= base;
        }
        return s.isEmpty() ? "0" : s;
    }

    static int val(char c) {
        return (c >= '0' && c <= '9') ? c - '0' : c - 'A' + 10;
    }
}
